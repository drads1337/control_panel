    "@tanstack/react-virtual": "^3.13.12",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.11.0",
    "change-case": "^5.4.4",
    "chart.js": "^4.5.0",
    "chrono-node": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "dotted-map": "^2.2.3",
    "embla-carousel-autoplay": "8.5.2",
    "embla-carousel-react": "8.5.2",
    "framer-motion": "^12.23.22",
    "immer": "^10.2.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.16.0",
    "little-date": "^1.0.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.474.0",
