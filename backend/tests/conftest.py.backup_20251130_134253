# Check if SQLite should be used (for faster local development)
USE_SQLITE = os.environ.get("USE_SQLITE", "").lower() == "1"

def wait_for_postgres(max_retries=30, retry_delay=1):
    """Wait for PostgreSQL to be ready"""
    if USE_SQLITE:
        return
    
    try:
        import psycopg2
        from psycopg2 import OperationalError
    except ImportError:
        # psycopg2 not installed, skip wait (will fail during connection if DB is not ready)
        return
    
    db_url = os.environ.get("DATABASE_URL")
    if not db_url or not db_url.startswith("postgresql"):
        return
    
    for i in range(max_retries):
        try:
            conn = psycopg2.connect(db_url)
            conn.close()
            return
        except OperationalError:
            if i < max_retries - 1:
                time.sleep(retry_delay)
            else:
                raise Exception(f"PostgreSQL not ready after {max_retries} attempts")

