[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    venv,
    migrations,
    *.pyc,
    .venv,
    env,
    build,
    dist
ignore =
    E203,
    E501,
    W503,
    E402,
    W291,
    W293,
    E128,
    E302,
    E305,
    W391,
    F541,
    E722,
    C901
per-file-ignores =
    __init__.py:F401
max-complexity = 20

