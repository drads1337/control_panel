# Example Nginx configuration with mTLS enabled
# Copy relevant sections to your nginx.conf and configure certificate paths

events {
    worker_connections 1024;
}

http {
    upstream panel_backend {
        least_conn;
        server panel-app-1:5001 max_fails=3 fail_timeout=30s;
        server panel-app-2:5001 max_fails=3 fail_timeout=30s;
        server panel-app-3:5001 max_fails=3 fail_timeout=30s;
    }

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

    server {
        listen 80;
        server_name _;
        
        # Redirect HTTP to HTTPS
        return 301 https://$host$request_uri;
    }

    # HTTPS server with mTLS
    server {
        listen 443 ssl http2;
        server_name _;
        
        # Allow large file uploads
        client_max_body_size 5G;

        # SSL configuration - optimized for performance
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:50m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;
        
        # OCSP stapling for better performance
        ssl_stapling on;
        ssl_stapling_verify on;

        # SECURITY: Mutual TLS (mTLS) Configuration
        # CA certificate for validating client certificates
        # This must be the same CA that signed the client certificates
        ssl_client_certificate /etc/nginx/ssl/ca-cert.pem;
        
        # Require client certificate verification
        # Options:
        #   on = require and verify client certificate (recommended for mTLS)
        #   optional = verify if present, but don't require (not recommended for security)
        #   off = disabled (no mTLS)
        ssl_verify_client on;
        
        # Maximum depth for certificate chain validation
        # Increase if you have intermediate CAs
        ssl_verify_depth 2;
        
        # Optional: Configure error page for certificate verification failures
        # error_page 495 496 = @mtls_error;
        # location @mtls_error {
        #     return 403 "Client certificate required or invalid";
        # }

        # Health check endpoint (no mTLS required)
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        # API endpoints with mTLS protection
        # All requests to /api/connect, /api/heartbeat, etc. require client certificates
        location /api/ {
            limit_req zone=api burst=20 nodelay;
            
            proxy_pass http://panel_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # SECURITY: Pass client certificate information to Flask for mTLS validation
            # These headers are used by the mTLS middleware to validate client certificates
            # The middleware checks these headers when MTLS_ENABLED=true
            proxy_set_header X-SSL-Client-Cert $ssl_client_cert;
            proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
            proxy_set_header X-SSL-Client-S-DN $ssl_client_s_dn;  # Subject Distinguished Name
            proxy_set_header X-SSL-Client-I-DN $ssl_client_i_dn;  # Issuer Distinguished Name
            proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
            proxy_set_header X-SSL-Client-Fingerprint $ssl_client_fingerprint;
            
            # Note: $ssl_client_cert contains the full certificate in PEM format (with newlines)
            # Flask middleware will extract and validate this information
            
            # Timeouts for large file uploads
            proxy_connect_timeout 5s;
            proxy_send_timeout 1800s;
            proxy_read_timeout 1800s;
            
            # Buffer settings
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
            proxy_busy_buffers_size 8k;
        }

        # Auth endpoints (can have different rate limiting)
        location /api/auth/ {
            limit_req zone=login burst=5 nodelay;
            
            proxy_pass http://panel_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Pass mTLS information (if mTLS is enabled globally)
            proxy_set_header X-SSL-Client-Cert $ssl_client_cert;
            proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
            proxy_set_header X-SSL-Client-S-DN $ssl_client_s_dn;
        }

        # Static files (no mTLS required)
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|json|webp|avif)$ {
            root /app/frontend/dist;
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable, max-age=31536000";
        }

        # Frontend SPA
        location / {
            root /app/frontend/dist;
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
    }
}

